{
  "import_dir": "",
  "output_dir": "",
  "output_per_import": false,
  "layout": "flat",
  "template": "{title}.{ext}",
  "name_filter": "safe",
  "conflict": "skip",
  "write_metadata": true,
  "export_cover": true,
  "embed_cover": false,
  "write_nfo": true,
  "copy_danmaku_xml": true,
  "container": "mp4",
  "hash_mode": "write",
  "skip_unfinished": true,
  "skip_existing": true,
  "summarize_unmerged": false,
  "cleanup_intermediate": true,
  "open_output_dir": false,
  "workers": 1,
  "engine": "auto",
  "ffmpeg_path": "",
  "mp4box_path": "",
  "work_dir": "",
  "ass": {
    "enabled": true,
    "reuse_existing": false,
    "font_name": "黑体",
    "font_size": 26,
    "alpha": 0.3,
    "bold": true,
    "outline": 0,
    "shadow": 1,
    "outline_color": "0x49516A",
    "outline_alpha": 0.1,
    "shadow_color": "0x49516A",
    "shadow_alpha": 0.1,
    "roll_time": 15.0,
    "fix_time": 5.0,
    "time_shift": 0.0,
    "roll_range": 1.0,
    "fixed_range": 1.0,
    "spacing": 0,
    "density": 0,
    "overlay": false,
    "canvas": "auto",
    "convert": "s -> r",
    "block_keywords": [],
    "download_missing": true,
    "keep_xml_copy": true
  }
}
